<?xml version="1.0" encoding="utf-8"?>
<!-- Navy tile that the launcher mask crops. Keeping the colour in the
     background layer (instead of padding a finished bitmap into the safe
     zone) is what lets the note fill the icon on every mask shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="1024"
                android:startColor="#FF161D30"
                android:endColor="#FF080B14" />
        </aapt:attr>
    </path>
</vector>
